API_PORT=3001
# Password Omar uses at /admin
ADMIN_PASSWORD=change-me
# Long random string used to sign admin sessions
ADMIN_SECRET=change-me-too
# Email to the admin for every new booking and shop order (https://resend.com)
RESEND_API_KEY=
# Where notifications go (several: separate with commas)
NOTIFY_EMAIL=
# Sender on a domain verified in Resend. Required to email customers their confirmation
# (without it, only the admin notifications are sent, from onboarding@resend.dev)
NOTIFY_FROM=

# ---------- Vercel ----------
# Set automatically when you connect a Neon Postgres database to the Vercel project.
# Without it, data is stored in server/data/db.json (local development).
DATABASE_URL=
# Set automatically when you connect a Vercel Blob store (admin photo uploads).
BLOB_READ_WRITE_TOKEN=
